# ==============================================================================
# Zauq (ذوق) v4.0.0 — Environment Configuration Example
# ==============================================================================
# Copy this file to '.env' and fill in your credentials.
# Safe Rollout: All v4 agentic & MCP features are disabled by default (flags=false).
# ==============================================================================

# ── 1. Discord Gateway Client ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# ── 2. Primary Tier-1 AI Providers ───────────────────────────────────────────
# Google Gemini (Default Tier 1 with Vision, Audio, Grounding & Thinking Mode)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude (Direct API: claude-sonnet-4-5, claude-3-5-sonnet, claude-3-5-haiku)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

# Alibaba Qwen (Direct API: qwen-turbo, qwen-plus, qwen-max)
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_DEFAULT_MODEL=qwen-turbo

# DeepSeek (Direct API: deepseek-chat, deepseek-coder, deepseek-reasoner)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# DigitalOcean Gradient Serverless Inference
DO_MODEL_ACCESS_KEY=your_digitalocean_gradient_access_key_here

# ── 3. Local / Self-Hosted Models ─────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
KAGGLE_TUNNEL_URL=https://your-tunnel-url.trycloudflare.com

# ── 4. Supabase Database (pgvector 768-dim) ───────────────────────────────────
# Requires Supabase PostgreSQL with pgvector extension enabled.
# Use service_role secret key so the backend can bypass RLS for internal operations.
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_secret_key_here

# ── 5. Backend Server & Security ──────────────────────────────────────────────
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
INTERNAL_API_KEY=your_random_64_char_hex_secret_here
GITHUB_ALLOWED_REPOS=Muhammad-Hassan12/Zauq,discord/discord-api-docs

# ── 6. Web Search Subsystem (Phase 2 & Phase 10) ──────────────────────────────
# Production search provider: 'serper' (primary) or 'duckduckgo' (fallback)
SERPER_API_KEY=your_serper_api_key_here
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_PAGES=3
GEMINI_NATIVE_GROUNDING_ENABLED=false

# ── 7. Bounded Agent Runtime (Phase 4 & Phase 9) ──────────────────────────────
# Master flag: Set to 'true' to route chat through the bounded tool-calling loop.
# Leave 'false' initially; enable per test guild first during safe rollout.
AGENT_RUNTIME_ENABLED=false
AGENT_MAX_TOOL_STEPS=4
AGENT_DEEP_MAX_TOOL_STEPS=6

# Observability, timeouts, and VPS protection (Phase 11)
AGENT_TOTAL_TIMEOUT_SECONDS=90.0
AGENT_DEEP_RESEARCH_TIMEOUT_SECONDS=180.0
WEB_FETCH_CONCURRENCY=3

# ── 8. Code Sandbox & Docker Socket Isolation (Phase 5 & Phase 12) ───────────
# If using the isolated sandbox-runner service (docker-compose), set URL:
# SANDBOX_RUNNER_URL=http://sandbox-runner:8001
SANDBOX_RUNNER_URL=
SANDBOX_MAX_CONCURRENCY=1
SANDBOX_DEFAULT_TIMEOUT_SECONDS=8
SANDBOX_MAX_OUTPUT_CHARS=12000
AUTO_CODE_TEST_DEFAULT=off          # 'off' | 'auto' | 'always'
AUTO_CODE_REPAIR_ATTEMPTS=1

# ── 9. Model Context Protocol (MCP) Client (Phase 6) ─────────────────────────
# Master flag: Set to 'true' to connect external tools from config/mcp_servers.json.
# Zero overhead when false.
MCP_ENABLED=false
MCP_CONFIG_PATH=config/mcp_servers.json
MCP_MAX_SERVERS=5
MCP_MAX_CONCURRENCY=4
MCP_DEFAULT_TIMEOUT_SECONDS=20.0
