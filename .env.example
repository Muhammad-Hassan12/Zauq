# Discord Bot Connection
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# LLMs APIs
GEMINI_API_KEY=your_gemini_api_key_here
DO_MODEL_ACCESS_KEY=your_digitalocean_gradient_access_key_here
OLLAMA_BASE_URL=http://localhost:11434
KAGGLE_TUNNEL_URL=https://your-tunnel-url.trycloudflare.com

# Database (Supabase with pgvector)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_secret_key_here  # Use service_role key to access tables with RLS enabled

# Backend Config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
INTERNAL_API_KEY=your_random_64_char_hex_secret_here
GITHUB_ALLOWED_REPOS=Muhammad-Hassan12/Zauq,discord/discord-api-docs
