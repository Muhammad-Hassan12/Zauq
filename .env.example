# Discord Bot Connection
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# LLMs APIs
GEMINI_API_KEY=your_gemini_api_key_here
DO_MODEL_ACCESS_KEY=your_digitalocean_gradient_access_key_here
OLLAMA_BASE_URL=http://localhost:11434
KAGGLE_TUNNEL_URL=https://your-tunnel-url.trycloudflare.com

# Database (Supabase with pgvector)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_secret_key_here  # Use service_role key to access tables with RLS enabled

# Backend Config
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
INTERNAL_API_KEY=your_random_64_char_hex_secret_here
GITHUB_ALLOWED_REPOS=Muhammad-Hassan12/Zauq,discord/discord-api-docs

# ── v4 New Tier-1 LLM Providers ──────────────────────────────────────────────
# Anthropic Claude direct API
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

# Alibaba Qwen direct API (QWEN_BASE_URL is region/workspace-specific)
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_DEFAULT_MODEL=qwen-turbo

# DeepSeek direct API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# ── v4 Web Search ─────────────────────────────────────────────────────────────
SERPER_API_KEY=
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_PAGES=3

# ── v4 Agent Runtime ──────────────────────────────────────────────────────────
# Keep false until Phase 4 agent runtime is tested and ready
AGENT_RUNTIME_ENABLED=false
AGENT_MAX_TOOL_STEPS=4
AGENT_DEEP_MAX_TOOL_STEPS=6

# ── v4 Sandbox ────────────────────────────────────────────────────────────────
SANDBOX_MAX_CONCURRENCY=1
SANDBOX_DEFAULT_TIMEOUT_SECONDS=8
SANDBOX_MAX_OUTPUT_CHARS=12000
AUTO_CODE_TEST_DEFAULT=off
AUTO_CODE_REPAIR_ATTEMPTS=1

# ── v4 MCP ────────────────────────────────────────────────────────────────────
# Keep false until MCP servers are configured in config/mcp_servers.json
MCP_ENABLED=false
MCP_CONFIG_PATH=config/mcp_servers.json
MCP_MAX_SERVERS=5
