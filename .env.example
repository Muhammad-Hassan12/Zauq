# Zauq v4 — copy to .env; leave optional credentials blank.
# Never commit .env. Generate INTERNAL_API_KEY with: openssl rand -hex 32
DISCORD_BOT_TOKEN=
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5
QWEN_API_KEY=
# Set the compatible endpoint for your Alibaba region/workspace.
QWEN_BASE_URL=
QWEN_DEFAULT_MODEL=qwen-turbo
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=deepseek-flash
DO_MODEL_ACCESS_KEY=
OLLAMA_BASE_URL=http://localhost:11434
KAGGLE_TUNNEL_URL=
SUPABASE_URL=
# Backend requires a service-role key, never a public anon key.
SUPABASE_KEY=
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8002
INTERNAL_API_KEY=
# Secondary key for /api/admin/* endpoints; falls back to INTERNAL_API_KEY if left blank
ADMIN_API_KEY=
# Explicit opt-in for local development only; Compose forces false.
DEVELOPMENT_MODE=false
GITHUB_ALLOWED_REPOS=Muhammad-Hassan12/Zauq,discord/discord-api-docs
SERPER_API_KEY=
# Only serper is implemented; no DuckDuckGo fallback.
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_CACHE_TTL_SECONDS=300
WEB_SEARCH_MAX_RESULTS=5
WEB_FETCH_MAX_PAGES=3
WEB_FETCH_MAX_BYTES=1000000
WEB_FETCH_CONCURRENCY=3
GEMINI_NATIVE_GROUNDING_ENABLED=false
AGENT_RUNTIME_ENABLED=false
AGENT_MAX_TOOL_STEPS=4
AGENT_DEEP_MAX_TOOL_STEPS=6
# CSV operator allowlists. Blank means unrestricted by this operator layer.
# Master flags and saved channel/server preferences still apply.
AGENT_ALLOWED_GUILD_IDS=
AGENT_ALLOWED_CHANNEL_IDS=
MCP_ALLOWED_GUILD_IDS=
MCP_ALLOWED_CHANNEL_IDS=
AGENT_TOTAL_TIMEOUT_SECONDS=90
AGENT_DEEP_RESEARCH_TIMEOUT_SECONDS=180
FILE_GENERATION_TIMEOUT_SECONDS=600
# Optional JSON: {"provider:model":[input_USD_per_million,output_USD_per_million]}
# Rates must match your actual account/model; unknown rates yield unknown cost.
MODEL_PRICING_JSON={}
# For local separate processes: http://127.0.0.1:8001
# Compose overrides this with http://sandbox-runner:8001.
SANDBOX_RUNNER_URL=
SANDBOX_MAX_CONCURRENCY=1
SANDBOX_DEFAULT_TIMEOUT_SECONDS=8
SANDBOX_MAX_OUTPUT_CHARS=12000
# Compose maps this host directory into the runner at /sandbox-spool.
SANDBOX_HOST_SPOOL_DIR=
# Leave blank outside Compose unless configuring a matching shared host spool.
SANDBOX_SPOOL_DIR=
AUTO_CODE_TEST_DEFAULT=off
AUTO_CODE_REPAIR_ATTEMPTS=1
MCP_ENABLED=false
MCP_CONFIG_PATH=config/mcp_servers.json
MCP_MAX_SERVERS=5
MCP_MAX_CONCURRENCY=4
MCP_DEFAULT_TIMEOUT_SECONDS=20
