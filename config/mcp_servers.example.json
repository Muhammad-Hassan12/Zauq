{
  "description": "Disabled templates. Supply real endpoints, explicit guild scope and verified allowed_tools before enabling.",
  "servers": [
    {
      "id": "github",
      "enabled": false,
      "transport": "streamable_http",
      "url": "https://mcp.example.com/github",
      "headers": {
        "Authorization": "Bearer ${GITHUB_TOKEN}"
      },
      "allowed_guild_ids": [
        "123456789012345678"
      ],
      "default_risk": "write",
      "timeout_seconds": 15.0,
      "namespace_prefix": "github",
      "tool_risks": {
        "create_issue": "write",
        "delete_branch": "destructive",
        "get_issue": "read"
      },
      "allow_global_access": false,
      "selection_keywords": [
        "github",
        "repository"
      ],
      "allowed_tools": [
        "get_issue",
        "create_issue"
      ]
    },
    {
      "id": "local-docs",
      "enabled": false,
      "transport": "stdio",
      "command": "python",
      "args": [
        "servers/docs_server.py"
      ],
      "env": {
        "DOCS_DIRECTORY": "${DOCS_DIRECTORY}"
      },
      "allowed_guild_ids": [
        "123456789012345678"
      ],
      "default_risk": "write",
      "timeout_seconds": 15.0,
      "namespace_prefix": "docs",
      "allow_global_access": false,
      "selection_keywords": [
        "docs",
        "documentation"
      ],
      "allowed_tools": [
        "search_docs"
      ],
      "tool_risks": {
        "search_docs": "read"
      }
    }
  ]
}
