FROM python:3.12-slim

# Install static Docker CLI binary into /usr/local/bin/docker and symlink to /usr/bin/docker
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-26.1.4.tgz | tar -xz -C /usr/local/bin --strip-components=1 docker/docker \
    && chmod 755 /usr/local/bin/docker \
    && ln -sf /usr/local/bin/docker /usr/bin/docker \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY backend ./backend

# Create dedicated non-root user, add to docker group so it can reach the socket
RUN adduser --disabled-password --no-create-home --uid 1000 zauq \
    && (getent group docker || groupadd -g 999 docker) \
    && adduser zauq docker \
    && mkdir -p /sandbox-spool \
    && chown -R zauq:zauq /app /sandbox-spool \
    && chmod 777 /sandbox-spool

USER zauq
EXPOSE 8001
CMD ["uvicorn", "backend.sandbox.runner_service:app", "--host", "0.0.0.0", "--port", "8001"]


