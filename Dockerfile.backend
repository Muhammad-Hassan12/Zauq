FROM python:3.12-slim

WORKDIR /app

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source code
COPY backend ./backend
COPY config/mcp_servers.example.json ./config/mcp_servers.example.json

# Create dedicated non-root user and hand over ownership
RUN adduser --disabled-password --no-create-home --uid 1000 zauq \
    && chown -R zauq:zauq /app
USER zauq

# Expose backend port
EXPOSE 8002

# Run FastAPI via Uvicorn
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8002"]
